{
	"name": "powersoft-amplifier",
	"version": "2.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"probe:workflow": "node scripts/api-probe.mjs",
		"probe:udp": "node scripts/canali-udp-probe.mjs",
		"probe:http-paths": "node scripts/http-paths-probe.mjs",
		"probe:summarize": "node scripts/summarize-probe.mjs",
		"probe:map": "node scripts/generate-mapping.mjs",
		"probe:unica": "node scripts/unica-paths-probe.mjs",
		"probe:retest-missing": "node scripts/retest-missing-paths.mjs"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dewiweb/companion-module-powersoft-amplifier.git"
	},
	"engines": {
		"node": "^22.14",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"got": "^14.4.7",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.2",
		"@types/node": "^22.14.1",
		"@types/ws": "^8.18.1",
		"eslint": "^10.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.1",
		"prettier": "^3.8.1",
		"rimraf": "^6.0.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.56.1"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.9.1"
}
